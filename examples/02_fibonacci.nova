# Recursion, a loop, and a jump table - the demo program for the report.
# Every phase of the compiler has something to say about this one.

func fib(n)
    if n < 2 then return n; end
    return fib(n - 1) + fib(n - 2);
end

let total = 0;
let i = 0;
while i < 10 do
    total = total + fib(i);
    i = i + 1;
end
print total;

# 'case' becomes a real jump table in the intermediate code,
# not a chain of comparisons.
case total of
    when 0:  print "zero";
    when 88: print "eighty-eight";
    otherwise print "something else";
end
